#!/usr/bin/env sh

# Get repo root relative to this script
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(dirname "$SCRIPT_DIR")"

echo "Running pre-push checks (unit tests)..."

# Backend unit tests
echo "Running backend tests..."
cd "$REPO_ROOT/backend" || { echo "Failed to cd to backend"; exit 1; }
npm run test || exit 1

# Frontend unit tests
echo "Running frontend tests..."
cd "$REPO_ROOT/frontend" || { echo "Failed to cd to frontend"; exit 1; }
npm run test || exit 1

echo "Pre-push checks passed!"

# E2E tests for develop and main branches (skip with SKIP_E2E=1 git push)
CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
if [ "$SKIP_E2E" != "1" ] && { [ "$CURRENT_BRANCH" = "develop" ] || [ "$CURRENT_BRANCH" = "main" ]; }; then
  echo ""
  echo "Running E2E tests (branch: $CURRENT_BRANCH)..."
  "$REPO_ROOT/scripts/run-e2e-local.sh" || exit 1
fi
