# Bitnami SealedSecrets - values are asymmetrically encrypted, not plaintext secrets
# These are false positives: key names like AUTH_JWT_SECRET look sensitive but values
# are encrypted ciphertext that can only be decrypted by the cluster's sealed-secrets controller.
kubernetes/staging-v2/sealed-secret.yaml:generic-api-key:5
kubernetes/staging/sealed-secret.yaml:generic-api-key:5
kubernetes/staging-v2/sealed-secret.yaml:generic-api-key:21
kubernetes/staging/sealed-secret.yaml:generic-api-key:21

# Production secrets-template.yaml - contains $(PLACEHOLDER) variables, not real secrets
kubernetes/production/secrets-template.yaml:database-url:8
kubernetes/production/secrets-template.yaml:database-url:22
kubernetes/production/secrets-template.yaml:database-password:51
kubernetes/production/secrets-template.yaml:database-password:66

