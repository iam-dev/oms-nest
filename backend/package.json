{
  "name": "oms-nestjs-api",
  "version": "1.0.0",
  "description": "OrderMySaddle NestJS API - Clean implementation replacing PHP/Symfony backend",
  "author": "",
  "private": true,
  "license": "MIT",
  "scripts": {
    "typeorm": "env-cmd ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "migration:generate": "npm run typeorm -- --dataSource=src/database/data-source.ts migration:generate",
    "postmigration:generate": "npm run lint -- --fix",
    "migration:create": "npm run typeorm -- migration:create",
    "migration:run": "npm run typeorm -- --dataSource=src/database/data-source.ts migration:run",
    "migration:revert": "npm run typeorm -- --dataSource=src/database/data-source.ts migration:revert",
    "schema:drop": "npm run typeorm -- --dataSource=src/database/data-source.ts schema:drop",
    "migration:staging:run": "env-cmd -f .env.staging ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js --dataSource=src/database/data-source.ts migration:run",
    "migration:staging:revert": "env-cmd -f .env.staging ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js --dataSource=src/database/data-source.ts migration:revert",
    "migration:staging:generate": "env-cmd -f .env.staging ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js --dataSource=src/database/data-source.ts migration:generate",
    "seed:create:relational": "hygen seeds create-relational",
    "generate:resource:relational": "hygen generate relational-resource",
    "postgenerate:resource:relational": "npm run lint -- --fix",
    "add:property:to-relational": "hygen property add-to-relational",
    "postadd:property:to-relational": "npm run lint -- --fix",
    "seed:run:relational": "ts-node -r tsconfig-paths/register ./src/database/seeds/relational/run-seed.ts",
    "prebuild": "rimraf dist",
    "build": "npx nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "npx nest start",
    "start:dev": "npx nest start --watch",
    "start:dev:local": "env-cmd -f .env.local npx nest start --watch",
    "start:swc": "npx nest start -b swc -w",
    "start:debug": "npx nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:unit": "jest --config ./test/unit/jest.config.js",
    "test:unit:watch": "jest --config ./test/unit/jest.config.js --watch",
    "test:unit:cov": "jest --config ./test/unit/jest.config.js --coverage",
    "test:unit:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --config ./test/unit/jest.config.js --runInBand",
    "test:e2e": "env-cmd --silent jest --config ./test/jest-e2e.json",
    "test:e2e:relational:docker": "docker compose -f docker-compose.relational.test.yaml --env-file env-example-relational -p tests up -d --build && docker compose -f docker-compose.relational.test.yaml -p tests exec api /opt/wait-for-it.sh -t 0 localhost:3000 -- npm run test:e2e -- --watchAll --runInBand && docker compose -f docker-compose.relational.test.yaml -p tests down && docker compose -p tests rm -svf",
    "migration:production": "ts-node -r tsconfig-paths/register ../scripts/migrate-production-data.ts",
    "migration:production:dry-run": "npm run migration:production -- --dry-run",
    "test:migration": "jest --config ./test/migration/jest.config.js",
    "test:migration:watch": "jest --config ./test/migration/jest.config.js --watch",
    "test:e2e-api": "jest --config ./test/e2e-api/jest.e2e-api.config.js",
    "test:e2e-api:watch": "jest --config ./test/e2e-api/jest.e2e-api.config.js --watch",
    "test:e2e-api:setup": "./test/e2e-api/scripts/setup-e2e.sh",
    "test:e2e-api:teardown": "./test/e2e-api/scripts/teardown-e2e.sh",
    "test:e2e-api:run": "./test/e2e-api/scripts/run-e2e-tests.sh",
    "test:e2e-api:full": "./test/e2e-api/scripts/setup-e2e.sh && jest --config ./test/e2e-api/jest.e2e-api.config.js",
    "prepare": "husky",
    "release": "release-it"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.982.0",
    "@aws-sdk/s3-request-presigner": "^3.982.0",
    "@keyv/redis": "^4.2.0",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/bullmq": "^11.0.3",
    "@nestjs/cache-manager": "^3.1.0",
    "@nestjs/common": "11.1.6",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.1.6",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/jwt": "11.0.1",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.1.6",
    "@nestjs/schedule": "^6.1.0",
    "@nestjs/swagger": "^11.2.3",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "11.0.0",
    "@types/multer-s3": "3.0.3",
    "axios": "^1.13.2",
    "bcryptjs": "3.0.2",
    "bullmq": "^5.34.8",
    "cache-manager": "^6.4.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "17.2.2",
    "handlebars": "4.7.8",
    "helmet": "^8.1.0",
    "ioredis": "^5.4.1",
    "ms": "2.1.3",
    "multer": "2.0.2",
    "multer-s3": "3.0.1",
    "nodemailer": "^7.0.11",
    "passport": "0.7.0",
    "passport-anonymous": "1.0.1",
    "passport-jwt": "4.0.1",
    "pg": "8.16.3",
    "prom-client": "^15.1.3",
    "redis": "^4.7.0",
    "reflect-metadata": "0.2.2",
    "rimraf": "6.0.1",
    "rxjs": "7.8.2",
    "source-map-support": "0.5.21",
    "swagger-ui-express": "5.0.1",
    "typeorm": "0.3.27",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "20.1.0",
    "@commitlint/config-conventional": "20.0.0",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.20.0",
    "@nestjs/cli": "^11.0.14",
    "@nestjs/schematics": "11.0.9",
    "@nestjs/testing": "11.1.6",
    "@release-it/conventional-changelog": "10.0.2",
    "@swc/cli": "0.7.8",
    "@swc/core": "1.13.4",
    "@types/bcryptjs": "3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "5.0.5",
    "@types/jest": "30.0.0",
    "@types/ms": "2.1.0",
    "@types/multer": "2.0.0",
    "@types/node": "22.19.1",
    "@types/passport-anonymous": "1.0.5",
    "@types/passport-jwt": "4.0.1",
    "@types/supertest": "6.0.3",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "8.47.0",
    "@typescript-eslint/parser": "8.47.0",
    "env-cmd": "10.1.0",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.4",
    "globals": "^16.0.0",
    "husky": "9.1.7",
    "hygen": "6.2.11",
    "is-ci": "4.1.0",
    "jest": "30.1.3",
    "prettier": "3.6.2",
    "prompts": "2.4.2",
    "release-it": "^19.2.4",
    "supertest": "7.1.4",
    "ts-jest": "29.4.5",
    "ts-loader": "9.5.4",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "tslib": "2.8.1",
    "typescript": "5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "./",
    "testRegex": "test/unit/.*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s",
      "!src/**/*.spec.ts",
      "!src/**/*.e2e-spec.ts",
      "!src/main.ts",
      "!src/**/*.module.ts",
      "!src/database/migrations/**",
      "!src/database/seeds/**"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node"
  },
  "overrides": {
    "cross-spawn": ">=7.0.5",
    "tar": ">=7.5.7",
    "fast-xml-parser": ">=5.3.4",
    "lodash": ">=4.17.23",
    "fork-ts-checker-webpack-plugin": {
      "schema-utils": {
        "ajv-keywords": "^5.1.0"
      }
    }
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release v${version}"
    },
    "github": {
      "release": true
    },
    "npm": {
      "publish": false
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "infile": "CHANGELOG.md",
        "preset": {
          "name": "conventionalcommits",
          "types": [
            {
              "type": "chore(deps)",
              "section": "Dependency Upgrades"
            },
            {
              "type": "fix(deps)",
              "section": "Dependency Upgrades"
            },
            {
              "type": "feat",
              "section": "Features"
            },
            {
              "type": "fix",
              "section": "Bug Fixes"
            },
            {
              "type": "perf",
              "section": "Performance Improvements"
            },
            {
              "type": "revert",
              "section": "Reverts"
            },
            {
              "type": "docs",
              "section": "Documentation"
            },
            {
              "type": "refactor",
              "section": "Code Refactoring"
            },
            {
              "type": "test",
              "section": "Tests"
            },
            {
              "type": "ci",
              "section": "Continuous Integration"
            }
          ]
        }
      }
    }
  }
}
