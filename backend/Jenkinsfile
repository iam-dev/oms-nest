pipeline {
    agent {
        kubernetes {
            yaml '''
apiVersion: v1
kind: Pod
metadata:
  labels:
    jenkins: oms-nest-ci
spec:
  containers:
    - name: node
      image: node:22-alpine
      command: ['sleep']
      args: ['infinity']
      resources:
        requests:
          cpu: 500m
          memory: 512Mi
        limits:
          cpu: '2'
          memory: 2Gi
    - name: docker
      image: docker:27-dind
      securityContext:
        privileged: true
      env:
        - name: DOCKER_TLS_CERTDIR
          value: ""
      resources:
        requests:
          cpu: 250m
          memory: 256Mi
        limits:
          cpu: '1'
          memory: 1Gi
    - name: helm
      image: alpine/helm:3.14
      command: ['sleep']
      args: ['infinity']
'''
        }
    }

    environment {
        DOCKER_HOST       = 'tcp://localhost:2375'
        REGISTRY          = 'ghcr.io'
        IMAGE_NAME        = 'iam-dev/oms-nest-backend'
        KUBECONFIG        = credentials('kubeconfig-oms')
    }

    options {
        timeout(time: 30, unit: 'MINUTES')
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    stages {
        stage('Install Dependencies') {
            steps {
                container('node') {
                    dir('backend') {
                        sh 'npm ci --production=false'
                    }
                }
            }
        }

        stage('Code Quality') {
            parallel {
                stage('Lint') {
                    steps {
                        container('node') {
                            dir('backend') {
                                sh 'npm run lint'
                            }
                        }
                    }
                }
                stage('Type Check') {
                    steps {
                        container('node') {
                            dir('backend') {
                                sh 'npx tsc --noEmit'
                            }
                        }
                    }
                }
                stage('Security Audit') {
                    steps {
                        container('node') {
                            dir('backend') {
                                sh 'npm audit --production || true'
                            }
                        }
                    }
                }
            }
        }

        stage('Build Application') {
            steps {
                container('node') {
                    dir('backend') {
                        sh 'npm run build'
                    }
                }
            }
        }

        stage('Run Tests') {
            parallel {
                stage('Unit Tests') {
                    steps {
                        container('node') {
                            dir('backend') {
                                sh 'npm run test:cov'
                            }
                        }
                    }
                }
                stage('Integration Tests') {
                    steps {
                        container('node') {
                            dir('backend') {
                                sh '''
                                    docker-compose -f docker-compose.relational.test.yaml up -d
                                    npm run test:e2e
                                '''
                            }
                        }
                    }
                    post {
                        always {
                            container('node') {
                                dir('backend') {
                                    sh 'docker-compose -f docker-compose.relational.test.yaml down || true'
                                }
                            }
                        }
                    }
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                container('docker') {
                    script {
                        env.IMAGE_TAG = "${env.REGISTRY}/${env.IMAGE_NAME}:${env.BRANCH_NAME}-${env.BUILD_NUMBER}"
                        env.IMAGE_LATEST = "${env.REGISTRY}/${env.IMAGE_NAME}:${env.BRANCH_NAME}"
                    }
                    dir('backend') {
                        sh "docker build -f Dockerfile.production -t ${env.IMAGE_TAG} -t ${env.IMAGE_LATEST} ."
                    }
                }
            }
        }

        stage('Push Docker Image') {
            steps {
                container('docker') {
                    withCredentials([usernamePassword(credentialsId: 'ghcr-credentials', usernameVariable: 'GHCR_USER', passwordVariable: 'GHCR_TOKEN')]) {
                        sh '''
                            set +x
                            echo "$GHCR_TOKEN" | docker login ghcr.io -u "$GHCR_USER" --password-stdin
                            docker push ${IMAGE_TAG}
                            docker push ${IMAGE_LATEST}
                            docker logout ghcr.io
                        '''
                    }
                }
            }
        }

        stage('Deploy to Staging') {
            when { branch 'staging' }
            steps {
                container('helm') {
                    sh """
                        helm upgrade --install oms-nest-staging ./kube/helm/oms-nest/ \
                            --namespace oms-nest-staging \
                            -f ./kube/helm/oms-nest/values-staging.yaml \
                            --set backend.image.tag=${env.BRANCH_NAME}-${env.BUILD_NUMBER} \
                            --wait --timeout=300s
                    """
                }
            }
        }

        stage('Deploy to Production') {
            when { branch 'production' }
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    input message: 'Deploy to Production?', ok: 'Deploy'
                }
                container('helm') {
                    sh """
                        helm upgrade --install oms-nest-production ./kube/helm/oms-nest/ \
                            --namespace oms-nest-production \
                            -f ./kube/helm/oms-nest/values-production.yaml \
                            --set backend.image.tag=${env.BRANCH_NAME}-${env.BUILD_NUMBER} \
                            --wait --timeout=300s
                    """
                }
            }
        }

        stage('Health Check') {
            when {
                anyOf {
                    branch 'staging'
                    branch 'production'
                }
            }
            steps {
                container('helm') {
                    script {
                        def healthUrl = env.BRANCH_NAME == 'production' ?
                            'https://api-nest-production.ordermysaddle.com/health' :
                            'https://api-nest-staging.ordermysaddle.com/health'

                        sh "wget -q -O- ${healthUrl} || exit 1"
                    }
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
        success {
            slackSend channel: '#oms-deployments',
                     color: 'good',
                     message: ":white_check_mark: NestJS build successful: ${env.JOB_NAME} - ${env.BUILD_NUMBER}"
        }
        failure {
            slackSend channel: '#oms-deployments',
                     color: 'danger',
                     message: ":x: NestJS build failed: ${env.JOB_NAME} - ${env.BUILD_NUMBER}"
        }
    }
}
